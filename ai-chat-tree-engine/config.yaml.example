# AI Chat Tree Engine — Configuration Example

# ─── Database ───────────────────────────────────────────────────
vault:
  path: "~/.local/share/ai-chat-tree/vault"
  create: true

# ─── Vector Store ──────────────────────────────────────────────
vector_store:
  db_path: "~/.local/share/ai-chat-tree/vector_store.db"
  embedding_model: "nomic-embed-text"
  embedding_provider: "ollama"
  # Provider options: ollama, sentence-transformers, mock
  # ollama — uses local Ollama instance (default)
  # sentence-transformers — uses HuggingFace sentence-transformers
  # mock — returns zero vectors for testing

# ─── Vector Store Embedding — Ollama ───────────────────────────
ollama:
  base_url: "http://localhost:11434"
  embedding_model: "nomic-embed-text"
  timeout: 30

# ─── Vector Store Embedding — Sentence Transformers ────────────
sentence_transformers:
  model: "all-MiniLM-L6-v2"
  device: "auto"  # auto, cpu, cuda, mps

# ─── Inference / LLM Backend ──────────────────────────────────
inference:
  provider: "ollama"  # ollama, openrouter, litellm
  timeout: 120
  max_retries: 3
  
  # Provider: ollama
  ollama:
    base_url: "http://localhost:11434"
    model: "mistral-small3.2"
    temperature: 0.7
    max_tokens: 4096
  
  # Provider: openrouter (API key required)
  openrouter:
    base_url: "https://openrouter.ai/api/v1"
    api_key: "${OPENROUTER_API_KEY}"
    model: "mistralai/mistral-small-3.2-24b-instruct"
    temperature: 0.7
    max_tokens: 4096

  # Provider: litellm (multi-vendor abstraction)
  litellm:
    # Set via env vars: OPENAI_API_KEY, ANTHROPIC_API_KEY, etc.
    api_base: null
    model_name: "gpt-4o-mini"

# ─── RLM Loop (Orchestrator) ──────────────────────────────────
rlm_loop:
  enabled: true
  config_path: null  # path to LiteLLM proxy config.yaml (optional)
  default_model: "mistral-small3.2"
  models:
    - model_id: "primary"
      provider: "ollama"
      name: "mistral-small3.2"
      temperature: 0.7
      max_tokens: 4096
    - model_id: "backup"
      provider: "ollama"
      name: "qwen2.5:32b"
      temperature: 0.7
      max_tokens: 4096
  fallback_chain:
    - "primary"
    - "backup"
  max_iterations: 5
  max_retries: 3
  retry_delay: 2
  observation_threshold: 0.65
  reflection_depth: 3
  reflection_mode: "auto"  # auto, manual, none

# ─── Engine (Web API) ─────────────────────────────────────────
engine:
  host: "0.0.0.0"
  port: 8000
  debug: false
  cors_origins:
    - "http://localhost:3000"

# ─── Logging ───────────────────────────────────────────────────
logging:
  level: "INFO"
  format: "%(asctime)s %(name)s %(levelname)s %(message)s"
